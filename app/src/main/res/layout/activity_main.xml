<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#F8F9FA">

    <!-- App Title -->
    <TextView
        android:id="@+id/tvAppTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="StudySync"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#1A73E8" />

    <TextView
        android:id="@+id/tvAppSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Campus Study &amp; Assignment Manager"
        android:textSize="14sp"
        android:textColor="#5F6368"
        android:layout_marginBottom="16dp"/>

    <!-- Student Info Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:elevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Developer: Kunwar Bibek"
                android:textStyle="bold"
                android:textColor="#202124"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Student ID: 2025621097"
                android:textColor="#5F6368"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Action Buttons / Management -->
    <Button
        android:id="@+id/btnViewGroups"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manage Study Groups"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#1A73E8"/>

    <Button
        android:id="@+id/btnViewTasks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="View Assignments &amp; Tasks"
        android:layout_marginBottom="24dp"
        android:backgroundTint="#1A73E8"/>

    <!-- Database Status Output -->
    <TextView
        android:id="@+id/tvDbStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Database Status: Initializing Room..."
        android:textSize="14sp"
        android:textColor="#137333"
        android:textStyle="italic"/>

</LinearLayout>